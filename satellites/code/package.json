{
    "name": "omnicontext-satellite",
    "displayName": "OmniContext Satellite",
    "description": "Connects VS Code to the OmniContext Cortex Brain.",
    "version": "0.1.0",
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "AI",
        "Other"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "omnicontext-view-container",
                    "title": "OmniContext",
                    "icon": "$(hubot)"
                }
            ]
        },
        "views": {
            "omnicontext-view-container": [
                {
                    "type": "webview",
                    "id": "omnicontext.sidebar",
                    "name": "Cortex Chat"
                }
            ]
        },
        "commands": [
            {
                "command": "omnicontext.connect",
                "title": "OmniContext: Connect to Brain"
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile && npm run lint",
        "lint": "eslint src --ext ts",
        "test": "node ./out/test/runTest.js"
    },
    "devDependencies": {
        "@types/vscode": "^1.85.0",
        "@types/node": "18.x",
        "@types/ws": "^8.5.10",
        "@typescript-eslint/eslint-plugin": "^6.15.0",
        "@typescript-eslint/parser": "^6.15.0",
        "eslint": "^8.56.0",
        "typescript": "^5.3.3"
    },
    "dependencies": {
        "ws": "^8.16.0"
    }
}